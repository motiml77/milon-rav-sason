{
  "name": "milon-rav-sason-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "מילון מונחים בפנימיות התורה",
  "main": "electron/main.cjs",
  "scripts": {
    "www": "node ../scripts/build-www.mjs www",
    "start": "npm run www && electron .",
    "dist": "npm run www && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "il.org.mlh.milon.ravsason",
    "productName": "MilonRavSason",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MilonRavSason-Setup.exe",
      "shortcutName": "מילון פנימיות התורה"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "40.4.1"
  }
}
